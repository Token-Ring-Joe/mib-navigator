 <class>Preferences</class>
 <widget class="QDialog" name="Preferences">
  <property name="windowTitle">
   <string>Preferences</string>
  </property>
  <layout class="QGridLayout">
   <item row="0" column="0">
    <widget class="QTreeWidget" name="PreferencesTree">
     <property name="rootIsDecorated">
      <bool>false</bool>
     </property>
     <property name="headerHidden">
      <bool>true</bool>
     </property>
     <property name="maximumWidth">
      <number>180</number>
     </property>
     <property name="minimumWidth">
      <number>120</number>
     </property>
     <property name="accessibleName">
      <string>Preferences section</string>
     </property>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QScrollArea" name="PreferencesScroll">
     <property name="widgetResizable">
      <bool>true</bool>
     </property>
     <property name="frameShape">
      <enum>QFrame::NoFrame</enum>
     </property>
     <widget class="QWidget" name="PreferencesScrollContents">
      <layout class="QVBoxLayout" name="preferencesPagesLayout">
       <property name="leftMargin">
        <number>0</number>
       </property>
       <property name="topMargin">
        <number>0</number>
       </property>
       <property name="rightMargin">
        <number>0</number>
       </property>
       <property name="bottomMargin">
        <number>0</number>
       </property>
       <property name="spacing">
        <number>12</number>
       </property>
       <item>
        <widget class="QStackedWidget" name="PreferencesProps">
         <widget class="QWidget" name="GeneralProps">
          <layout class="QVBoxLayout">
           <item>
            <widget class="QLabel" name="GeneralHeading">
             <property name="text">
              <string>General</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="caption" stdset="0">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="AppearanceHelp">
             <property name="text">
              <string>Choose Follow System, Light or Dark from Settings &gt; Appearance. Browse and manage MIBs in MIBs &gt; Library.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="ShowAgentName">
             <property name="text">
              <string>Show hostnames alongside addresses in query output</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="HostnameHelp">
             <property name="text">
              <string>Hostname lookup can depend on DNS response time.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="spacer0">
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>20</width>
               <height>20</height>
              </size>
             </property>
            </spacer>
           </item>
           <property name="leftMargin">
            <number>12</number>
           </property>
           <property name="topMargin">
            <number>12</number>
           </property>
           <property name="rightMargin">
            <number>12</number>
           </property>
           <property name="bottomMargin">
            <number>12</number>
           </property>
           <property name="spacing">
            <number>12</number>
           </property>
          </layout>
         </widget>
         <widget class="QWidget" name="SnmpProps">
          <layout class="QVBoxLayout">
           <item>
            <widget class="QLabel" name="SnmpHeading">
             <property name="text">
              <string>SNMP</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="caption" stdset="0">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="EnableIPv4">
             <property name="text">
              <string>Enable IPv4</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="EnableIPv6">
             <property name="text">
              <string>Enable IPv6</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="TransportValidation">
             <property name="text">
              <string>Enable at least one transport protocol.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QFormLayout">
             <item row="0" column="0">
              <widget class="QLabel" name="RequestPortLabel">
               <property name="text">
                <string>Default SNMP port</string>
               </property>
               <property name="buddy">
                <cstring>RequestPort</cstring>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QSpinBox" name="RequestPort">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>65535</number>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="RequestTimeoutLabel">
               <property name="text">
                <string>Timeout (seconds)</string>
               </property>
               <property name="buddy">
                <cstring>RequestTimeout</cstring>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QSpinBox" name="RequestTimeout">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>3600</number>
               </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="RequestRetriesLabel">
               <property name="text">
                <string>Retries</string>
               </property>
               <property name="buddy">
                <cstring>RequestRetries</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QSpinBox" name="RequestRetries">
               <property name="minimum">
                <number>0</number>
               </property>
               <property name="maximum">
                <number>100</number>
               </property>
              </widget>
             </item>
             <item row="3" column="0">
              <widget class="QLabel" name="BulkNonRepeatersLabel">
               <property name="text">
                <string>GETBULK non-repeaters</string>
               </property>
               <property name="buddy">
                <cstring>BulkNonRepeaters</cstring>
               </property>
              </widget>
             </item>
             <item row="3" column="1">
              <widget class="QSpinBox" name="BulkNonRepeaters">
               <property name="minimum">
                <number>0</number>
               </property>
               <property name="maximum">
                <number>65535</number>
               </property>
              </widget>
             </item>
             <item row="4" column="0">
              <widget class="QLabel" name="BulkMaxRepetitionsLabel">
               <property name="text">
                <string>GETBULK max repetitions</string>
               </property>
               <property name="buddy">
                <cstring>BulkMaxRepetitions</cstring>
               </property>
              </widget>
             </item>
             <item row="4" column="1">
              <widget class="QSpinBox" name="BulkMaxRepetitions">
               <property name="minimum">
                <number>0</number>
               </property>
               <property name="maximum">
                <number>65535</number>
               </property>
              </widget>
             </item>
             <item row="5" column="0">
              <widget class="QLabel" name="RequestContextNameLabel">
               <property name="text"><string>SNMPv3 context name</string></property>
               <property name="buddy"><cstring>RequestContextName</cstring></property>
              </widget>
             </item>
             <item row="5" column="1">
              <widget class="QLineEdit" name="RequestContextName">
               <property name="placeholderText"><string>Default context (empty)</string></property>
               <property name="toolTip"><string>Applies to new SNMPv3 operations. Existing operations keep their captured context.</string></property>
              </widget>
             </item>
             <property name="horizontalSpacing">
              <number>16</number>
             </property>
             <property name="verticalSpacing">
              <number>12</number>
             </property>
             <property name="rowWrapPolicy">
              <enum>QFormLayout::WrapLongRows</enum>
             </property>
            </layout>
           </item>
           <item>
            <widget class="QLabel" name="RequestHelp">
             <property name="text">
              <string>The default port is used when Target has no explicit port. Transport changes take effect after restarting MIB Navigator.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="spacer1">
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>20</width>
               <height>20</height>
              </size>
             </property>
            </spacer>
           </item>
           <property name="leftMargin">
            <number>12</number>
           </property>
           <property name="topMargin">
            <number>12</number>
           </property>
           <property name="rightMargin">
            <number>12</number>
           </property>
           <property name="bottomMargin">
            <number>12</number>
           </property>
           <property name="spacing">
            <number>12</number>
           </property>
          </layout>
         </widget>
         <widget class="QWidget" name="TrapsProps">
          <layout class="QVBoxLayout">
           <item>
            <widget class="QLabel" name="TrapsHeading">
             <property name="text">
              <string>Traps</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
             <property name="caption" stdset="0">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QFormLayout">
             <item row="0" column="0">
              <widget class="QLabel" name="TrapPortLabel">
               <property name="text">
                <string>IPv4 listen port</string>
               </property>
               <property name="buddy">
                <cstring>TrapPort</cstring>
               </property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QSpinBox" name="TrapPort">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>65535</number>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="TrapPort6Label">
               <property name="text">
                <string>IPv6 listen port</string>
               </property>
               <property name="buddy">
                <cstring>TrapPort6</cstring>
               </property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QSpinBox" name="TrapPort6">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>65535</number>
               </property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="TrapHistoryLimitLabel">
               <property name="text">
                <string>History limit (traps)</string>
               </property>
               <property name="buddy">
                <cstring>TrapHistoryLimit</cstring>
               </property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QSpinBox" name="TrapHistoryLimit">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>100000</number>
               </property>
              </widget>
             </item>
             <property name="horizontalSpacing">
              <number>16</number>
             </property>
             <property name="verticalSpacing">
              <number>12</number>
             </property>
             <property name="rowWrapPolicy">
              <enum>QFormLayout::WrapLongRows</enum>
             </property>
            </layout>
           </item>
           <item>
            <widget class="QCheckBox" name="ExpandTrapBinding">
             <property name="text">
              <string>Expand notification details when selecting a trap</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="TrapsHelp">
             <property name="text">
              <string>Listen-port changes require a restart. The history limit applies immediately after OK; reducing it removes the oldest retained traps.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="spacer2">
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>20</width>
               <height>20</height>
              </size>
             </property>
            </spacer>
           </item>
           <property name="leftMargin">
            <number>12</number>
           </property>
           <property name="topMargin">
            <number>12</number>
           </property>
           <property name="rightMargin">
            <number>12</number>
           </property>
           <property name="bottomMargin">
            <number>12</number>
           </property>
           <property name="spacing">
            <number>12</number>
           </property>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item row="1" column="0" colspan="2">
    <widget class="QDialogButtonBox" name="OKCancelBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
   <property name="leftMargin">
    <number>16</number>
   </property>
   <property name="topMargin">
    <number>16</number>
   </property>
   <property name="rightMargin">
    <number>16</number>
   </property>
   <property name="bottomMargin">
    <number>16</number>
   </property>
   <property name="spacing">
    <number>12</number>
   </property>
  </layout>
 </widget>
 <resources />
 <connections>
  <connection>
   <sender>OKCancelBox</sender>
   <signal>accepted()</signal>
   <receiver>Preferences</receiver>
   <slot>accept()</slot>
  </connection>
  <connection>
   <sender>OKCancelBox</sender>
   <signal>rejected()</signal>
   <receiver>Preferences</receiver>
   <slot>reject()</slot>
  </connection>
 </connections>
</ui>
